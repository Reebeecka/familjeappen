# Kopiera denna fil till .env.local och fyll i värdena från Supabase.
# Du hittar dem i Supabase: Project Settings -> API

# Projektets URL (ser ut som https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Den publika "anon"-nyckeln (lång textsträng, börjar ofta med "eyJ...")
VITE_SUPABASE_ANON_KEY=

# Publik VAPID-nyckel för push-notiser (genereras, se NOTISER.md)
VITE_VAPID_PUBLIC_KEY=
